#!/bin/bash

set -euo pipefail

label="com.lammax.remote"
domain="gui/$(id -u)"
service_target="${domain}/${label}"
plist_path="${HOME}/Library/LaunchAgents/${label}.plist"
token_path="${HOME}/Library/Application Support/Remote/token"
health_url="http://127.0.0.1:3010/health"
public_origin="https://macbook-pro.tailab24a8.ts.net"
approvals_url="${public_origin}/approvals"
claude_url="${public_origin}/claude"

is_loaded() {
    launchctl print "${service_target}" >/dev/null 2>&1
}

is_healthy() {
    /usr/bin/curl --fail --silent --show-error --max-time 2 "${health_url}" >/dev/null 2>&1
}

wait_until_healthy() {
    local attempt
    for attempt in {1..20}; do
        if is_healthy; then
            return 0
        fi
        sleep 1
    done
    return 1
}

start_remote() {
    if ! is_healthy; then
        if is_loaded; then
            launchctl kickstart -k "${service_target}"
        else
            launchctl bootstrap "${domain}" "${plist_path}"
        fi
        if ! wait_until_healthy; then
            echo "Remote did not become healthy. Check ${HOME}/Library/Logs/Remote/remote.err.log" >&2
            exit 1
        fi
    fi

    if [[ ! -r "${token_path}" ]]; then
        echo "Remote is healthy, but its token file is unavailable." >&2
        exit 1
    fi
    /usr/bin/tr -d '\r\n' < "${token_path}" | /usr/bin/pbcopy
    echo "Remote approvals: ${approvals_url}"
    echo "Remote Claude: ${claude_url}"
    echo "The login token was copied to the Mac clipboard for Universal Clipboard paste on iPhone."
    echo "Install the approvals page on the iPhone Home Screen before enabling notifications."
}

status_remote() {
    if is_healthy; then
        echo "Remote is running and healthy."
        echo "Approvals: ${approvals_url}"
        echo "Claude tasks: ${claude_url}"
        echo "Tailscale Serve terminates HTTPS; the local backend is ${health_url}."
        return 0
    fi
    if is_loaded; then
        echo "Remote is loaded by launchd but is not healthy." >&2
    else
        echo "Remote is stopped." >&2
    fi
    return 1
}

stop_remote() {
    if is_loaded; then
        launchctl bootout "${service_target}"
        echo "Remote stopped. It will start automatically at the next macOS login or with /remote-start."
    else
        echo "Remote is already stopped."
    fi
}

test_remote() {
    status_remote
    if ! claude mcp list 2>&1 | /usr/bin/grep -q '^remote: .*Connected'; then
        echo "Claude MCP registration 'remote' is not connected." >&2
        exit 1
    fi
    echo "Claude MCP registration 'remote' is connected."
}

case "${1:-}" in
    start)
        start_remote
        ;;
    status)
        status_remote
        ;;
    stop)
        stop_remote
        ;;
    test)
        test_remote
        ;;
    *)
        echo "Usage: remote-control {start|status|stop|test}" >&2
        exit 64
        ;;
esac
